<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChordCraft | 雰囲気から作るピアノコード進行メーカー</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tone.js (Web Audio Synthesizer) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- Google Fonts: Inter & Noto Sans JP -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', 'Noto Sans JP', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }
        /* ピアノ鍵盤のカスタムスタイル */
        .piano-container {
            position: relative;
            height: 140px;
            user-select: none;
        }
        .white-key {
            background: linear-gradient(to bottom, #ffffff 0%, #f1f5f9 100%);
            border: 1px solid #cbd5e1;
            border-radius: 0 0 6px 6px;
            transition: all 0.1s ease;
        }
        .white-key.active {
            background: linear-gradient(to bottom, #38bdf8 0%, #0284c7 100%);
            border-color: #0369a1;
            transform: translateY(2px);
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.6);
        }
        .black-key {
            background: linear-gradient(to bottom, #334155 0%, #0f172a 100%);
            border: 1px solid #020617;
            border-radius: 0 0 4px 4px;
            z-index: 10;
            transition: all 0.1s ease;
        }
        .black-key.active {
            background: linear-gradient(to bottom, #f43f5e 0%, #be123c 100%);
            border-color: #881337;
            transform: translateY(2px);
            box-shadow: 0 0 15px rgba(244, 63, 94, 0.7);
        }
        /* カスタムスクロールバー */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-sky-500 selection:text-white">

    <!-- ヘッダー -->
    <header class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-30">
        <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-400 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20">
                    <i class="fa-solid fa-music text-white text-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-400">
                        ChordCraft
                    </h1>
                    <p class="text-xs text-slate-400">雰囲気ブロックを組み合わせて作るピアノコード進行</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button onclick="openHelpModal()" class="text-sm text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-2 rounded-lg transition flex items-center gap-2">
                    <i class="fa-regular fa-circle-question"></i>
                    <span class="hidden sm:inline">使い方</span>
                </button>
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-2 rounded-lg transition flex items-center gap-2" title="GitHubリポジトリ用リンク">
                    <i class="fa-brands fa-github text-base"></i>
                    <span class="hidden sm:inline">GitHub</span>
                </a>
            </div>
        </div>
    </header>

    <!-- メインコンテンツ -->
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 py-6 space-y-6">

        <!-- STEP 1: 雰囲気ブロック・パレット（ドラッグまたはタップで配置） -->
        <section class="bg-slate-900/70 border border-slate-800 rounded-2xl p-4 sm:p-5 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                    <h2 class="text-base sm:text-lg font-bold flex items-center gap-2 text-sky-400">
                        <span class="bg-sky-500/20 text-sky-400 w-7 h-7 rounded-full flex items-center justify-center text-sm">1</span>
                        ピースを選んでスロットに並べよう
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5 ml-9">ブロックやコードを下の「1〜4小節目」へドラッグ＆ドロップ（またはタップで順番に追加）</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="generateRandomBlocks()" class="text-xs sm:text-sm bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 border border-indigo-500/30 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5">
                        <i class="fa-solid fa-dice"></i> ランダム組み立て
                    </button>
                    <button onclick="clearAllSlots()" class="text-xs sm:text-sm bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5">
                        <i class="fa-solid fa-rotate-left"></i> リセット
                    </button>
                </div>
            </div>

            <!-- 選択モード切り替えタブ -->
            <div class="flex flex-wrap items-center gap-2 border-b border-slate-800 pb-3">
                <button id="tab-mood" onclick="switchPaletteMode('mood')" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 bg-sky-600 text-white shadow-md shadow-sky-500/20">
                    <i class="fa-solid fa-palette"></i> 雰囲気ブロックから選ぶ（初心者向け）
                </button>
                <button id="tab-all-chords" onclick="switchPaletteMode('chords')" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 bg-slate-800 text-slate-300 hover:bg-slate-700">
                    <i class="fa-solid fa-guitar"></i> すべてのコードから直接選ぶ（自由作成）
                </button>
            </div>

            <!-- モードA: 雰囲気ブロック一覧 -->
            <div id="block-palette" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5">
                <!-- JSで動的に雰囲気ブロックを生成 -->
            </div>

            <!-- モードB: すべてのコード直接選択パレット -->
            <div id="all-chords-palette" class="hidden space-y-4">
                <!-- ルート音選択（12音） -->
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-slate-300">① ルート音（基準の音）を選択：</span>
                        <span class="text-[11px] text-slate-400">※白鍵と黒鍵すべての音から選べます</span>
                    </div>
                    <div id="root-note-selector" class="grid grid-cols-6 sm:grid-cols-12 gap-1.5">
                        <!-- JSでC〜Bの12音ボタンを生成 -->
                    </div>
                </div>

                <!-- コードタイプ一覧（選択中のルート音に対する全バリエーション） -->
                <div class="space-y-1.5">
                    <span class="text-xs font-bold text-slate-300">② コードの種類を選んでスロットに配置（ドラッグまたはタップ）：</span>
                    <div id="chord-type-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2">
                        <!-- JSで maj, min, 7, maj7, min7, sus4, add9, dim, aug, m7b5 を生成 -->
                    </div>
                </div>

                <!-- ベース音（オンコード）オプション選択 -->
                <div class="pt-2 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-sky-400">
                            <i class="fa-solid fa-slash mr-1"></i>③ オンコード（ベース音指定・任意）：
                        </span>
                        <select id="palette-bass-select" onchange="changePaletteBassNote(this.value)" class="bg-slate-800 border border-slate-600 text-white text-xs sm:text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:border-sky-500">
                            <option value="-1" selected>なし（通常のコード）</option>
                            <option value="0">/C（ド）</option>
                            <option value="1">/C#（ド#）</option>
                            <option value="2">/D（レ）</option>
                            <option value="3">/D#（レ#）</option>
                            <option value="4">/E（ミ）</option>
                            <option value="5">/F（ファ）</option>
                            <option value="6">/F#（ファ#）</option>
                            <option value="7">/G（ソ）</option>
                            <option value="8">/G#（ソ#）</option>
                            <option value="9">/A（ラ）</option>
                            <option value="10">/A#（ラ#）</option>
                            <option value="11">/B（シ）</option>
                        </select>
                    </div>
                    <span class="text-[11px] text-slate-400">例：ルート「F」＋ ベース「/G」＝ <strong class="text-slate-200">F/G</strong>（滑らかなベース進行に最適）</span>
                </div>
            </div>
        </section>

        <!-- STEP 2: 組み立てステージ（4小節スロット）＆再生コントロール -->
        <section class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-4 sm:p-6 shadow-xl space-y-6">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-slate-700/80 pb-5">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="bg-sky-500/20 text-sky-400 w-7 h-7 rounded-full flex items-center justify-center text-sm font-bold">2</span>
                        <h3 class="text-lg sm:text-xl font-bold text-white">あなたのコード進行ステージ</h3>
                    </div>
                    <p id="progression-mood-summary" class="text-xs sm:text-sm text-sky-300/90 mt-1 ml-9">
                        組み合わせの雰囲気：王道で爽やかなストーリー展開
                    </p>
                </div>

                <!-- 再生・停止・書き出しボタン -->
                <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                    <button id="play-btn" onclick="togglePlay()" class="flex-1 sm:flex-none bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-bold px-6 py-3 rounded-xl shadow-lg shadow-sky-500/25 transition transform active:scale-95 flex items-center justify-center gap-2 min-w-[140px]">
                        <i id="play-icon" class="fa-solid fa-play"></i>
                        <span id="play-text">再生する</span>
                    </button>

                    <button onclick="copyProgressionText()" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-4 py-3 rounded-xl transition flex items-center gap-2 text-sm font-medium" title="コード進行をテキストでコピー">
                        <i class="fa-regular fa-copy"></i>
                        <span>コピー</span>
                    </button>

                    <button onclick="downloadMidi()" class="bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 px-4 py-3 rounded-xl transition flex items-center gap-2 text-sm font-medium" title="DTMソフトで使えるMIDIファイルをダウンロード">
                        <i class="fa-solid fa-download"></i>
                        <span>MIDI保存</span>
                    </button>
                </div>
            </div>

            <!-- 4小節の組み立てスロット -->
            <div class="space-y-2">
                <div class="flex items-center justify-between text-xs text-slate-400">
                    <span>※スロットの「×」で解除、カードクリックで単音試聴、下のボタンで響きを微調整できます</span>
                    <span class="hidden sm:inline">4小節ループ構成</span>
                </div>
                <div id="chord-slots" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                    <!-- JSで4つのドロップ可能なスロットを生成 -->
                </div>
            </div>

            <!-- パラメータ設定（キー・BPM・弾き方） -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-t border-slate-700/60">
                <!-- キー（高さ）変更 -->
                <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700/50">
                    <label class="block text-xs text-slate-400 mb-1.5 font-medium">
                        <i class="fa-solid fa-sliders mr-1 text-sky-400"></i> キー（音の高さ）
                    </label>
                    <select id="key-select" onchange="changeKey(this.value)" class="w-full bg-slate-800 border border-slate-600 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-sky-500">
                        <option value="0" selected>C メジャー（白鍵メイン・初心者向け）</option>
                        <option value="2">D メジャー（明るい響き）</option>
                        <option value="4">E メジャー（華やか）</option>
                        <option value="5">F メジャー（温かみがある）</option>
                        <option value="7">G メジャー（爽快）</option>
                        <option value="9">A メジャー（力強い）</option>
                        <option value="-2">B♭ メジャー（吹奏楽・ジャズ風）</option>
                    </select>
                </div>

                <!-- テンポ（BPM） -->
                <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700/50">
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="text-xs text-slate-400 font-medium">
                            <i class="fa-solid fa-gauge-high mr-1 text-sky-400"></i> テンポ (BPM)
                        </label>
                        <span id="bpm-display" class="text-xs font-bold text-sky-400 bg-sky-950 px-2 py-0.5 rounded">115</span>
                    </div>
                    <input id="bpm-slider" type="range" min="60" max="180" value="115" oninput="changeBpm(this.value)" class="w-full accent-sky-500 cursor-pointer h-2 bg-slate-700 rounded-lg">
                </div>

                <!-- 弾き方（アルペジオ/和音） -->
                <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700/50">
                    <label class="block text-xs text-slate-400 mb-1.5 font-medium">
                        <i class="fa-solid fa-hands mr-1 text-sky-400"></i> ピアノの弾き方
                    </label>
                    <select id="style-select" onchange="changePlayStyle(this.value)" class="w-full bg-slate-800 border border-slate-600 text-white text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-sky-500">
                        <option value="block">じゃーん（基本の和音）</option>
                        <option value="arpeggio">ポロロン（バラード風アルペジオ）</option>
                        <option value="rhythm" selected>ズン・チャッ（軽快リズム）</option>
                    </select>
                </div>
            </div>

            <!-- STEP 3: リアルタイムピアノ鍵盤ビジュアライザー -->
            <div class="bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2">
                <div class="flex items-center justify-between text-xs text-slate-400">
                    <span class="flex items-center gap-2">
                        <i class="fa-solid fa-keyboard text-sky-400"></i>
                        <span>押さえる鍵盤ガイド（青＝白鍵 / 赤＝黒鍵）</span>
                    </span>
                    <span id="active-notes-text" class="font-mono text-sky-300 font-semibold">コードをクリックして確認</span>
                </div>
                <!-- 2オクターブ分のピアノ鍵盤描画エリア -->
                <div class="overflow-x-auto pb-1">
                    <div id="piano-keyboard" class="piano-container min-w-[600px] w-full flex relative">
                        <!-- JSで鍵盤を生成 -->
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- フッター -->
    <footer class="border-t border-slate-800/80 py-6 text-center text-xs text-slate-500">
        <p>ChordCraft - Open Source Piano Chord Progression Generator</p>
        <p class="mt-1">Built with HTML, Tailwind CSS & Tone.js | Ready for GitHub Pages</p>
    </footer>

    <!-- トースト通知用メッセージボックス -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-800 border border-sky-500/50 text-white px-4 py-3 rounded-xl shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 z-50 flex items-center gap-2.5 text-sm">
        <i class="fa-solid fa-circle-check text-sky-400"></i>
        <span id="toast-msg">メッセージ</span>
    </div>

    <!-- 使い方モーダル -->
    <div id="help-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
        <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-2xl">
            <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-wand-magic-sparkles text-sky-400"></i> ChordCraftの使い方
                </h3>
                <button onclick="closeHelpModal()" class="text-slate-400 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="space-y-3 text-sm text-slate-300 leading-relaxed">
                <p><strong class="text-sky-400">1. ピースを並べる（2つのモード）：</strong> 知識がない方は「雰囲気ブロック」から感情のピースを並べるだけでOK！特定のコードを指定したいときは「すべてのコードから直接選ぶ」タブに切り替えて、12音×10種類の全コードから自由に組み合わせられます。</p>
                <p><strong class="text-sky-400">2. 音を確認する：</strong> 「再生する」を押すと組み合わせた進行がループ再生され、押さえる鍵盤がリアルタイムに光ります。</p>
                <p><strong class="text-sky-400">3. アレンジする：</strong> 各スロットのコードプルダウンや「✨ おしゃれ化」「🔄 響き変更」ボタンで、いつでも別のコードや響きに差し替えられます。</p>
                <p><strong class="text-sky-400">4. 保存・活用：</strong> 「MIDI保存」を押すと、GarageBandやCubaseなどのDTMソフトにそのまま読み込めるMIDIファイルがダウンロードできます。</p>
            </div>
            <div class="pt-2 text-right">
                <button onclick="closeHelpModal()" class="bg-sky-600 hover:bg-sky-500 text-white px-5 py-2 rounded-lg text-sm font-medium transition">
                    さっそく作る！
                </button>
            </div>
        </div>
    </div>

    <script>
        // ==========================================
        // 1. 雰囲気ブロック・データベース（1ピース＝1小節の感情）
        // ==========================================
        // Cメジャー基準 (0=C, 2=D, 4=E, 5=F, 7=G, 9=A, 11=B)
        const MOOD_BLOCKS = [
            {
                id: 'bright-start',
                name: '明るい始まり',
                tag: '王道・安定',
                icon: 'fa-sun',
                color: 'from-sky-400 to-blue-500',
                border: 'border-sky-500/40',
                root: 0, // C
                type: 'maj',
                desc: 'まっすぐで爽やかなスタート'
            },
            {
                id: 'hopeful-lift',
                name: '視界が開ける',
                tag: '感動・広がり',
                icon: 'fa-cloud-sun',
                color: 'from-emerald-400 to-teal-500',
                border: 'border-emerald-500/40',
                root: 5, // F
                type: 'maj',
                desc: '空が広がるような温かい響き'
            },
            {
                id: 'emotional-peak',
                name: '感情の高まり',
                tag: 'サビ前・推進力',
                icon: 'fa-fire',
                color: 'from-orange-400 to-red-500',
                border: 'border-orange-500/40',
                root: 7, // G
                type: 'maj',
                desc: '次へ進みたくなるエネルギー'
            },
            {
                id: 'sad-nostalgia',
                name: '切ない余韻',
                tag: 'エモ・泣き',
                icon: 'fa-droplet',
                color: 'from-indigo-400 to-purple-600',
                border: 'border-indigo-500/40',
                root: 9, // Am
                type: 'min',
                desc: '胸がキュッとなるセンチメンタル感'
            },
            {
                id: 'gentle-sorrow',
                name: '夕暮れの優しさ',
                tag: '儚い・繊細',
                icon: 'fa-feather',
                color: 'from-pink-400 to-rose-500',
                border: 'border-pink-500/40',
                root: 4, // Em
                type: 'min',
                desc: 'そっと寄り添うような儚い響き'
            },
            {
                id: 'walking-memory',
                name: '懐かしい帰り道',
                tag: '青春・穏やか',
                icon: 'fa-shoe-prints',
                color: 'from-amber-400 to-yellow-500',
                border: 'border-amber-500/40',
                root: 2, // Dm7
                type: 'min7',
                desc: '思い出を振り返るような温もり'
            },
            {
                id: 'lofi-chill',
                name: 'おしゃれな夜風',
                tag: 'Lo-Fi・都会的',
                icon: 'fa-mug-hot',
                color: 'from-teal-400 to-cyan-600',
                border: 'border-teal-500/40',
                root: 5, // FM7
                type: 'maj7',
                desc: 'カフェで流れるような浮遊感'
            },
            {
                id: 'jazz-spice',
                name: '大人のスパイス',
                tag: 'ジャジー・艶',
                icon: 'fa-martini-glass',
                color: 'from-fuchsia-500 to-purple-700',
                border: 'border-fuchsia-500/40',
                root: 4, // E7 (セカンダリードミナント)
                type: '7',
                desc: '一気に都会的でドラマチックに変化'
            },
            {
                id: 'dramatic-twist',
                name: 'ドラマチックな転換',
                tag: '映画風・切替',
                icon: 'fa-bolt',
                color: 'from-rose-500 to-red-700',
                border: 'border-rose-500/40',
                root: 0, // C7 (Fへ繋がるスパイス)
                type: '7',
                desc: '物語が大きく動き出す予感'
            },
            {
                id: 'floating-dream',
                name: '夢見心地の浮遊',
                tag: '幻想・透明感',
                icon: 'fa-wand-sparkles',
                color: 'from-cyan-400 to-indigo-500',
                border: 'border-cyan-500/40',
                root: 0, // CM7
                type: 'maj7',
                desc: 'キラキラと透き通るような着地'
            },
            {
                id: 'anticipation',
                name: 'ワクワクする予感',
                tag: '軽快・期待',
                icon: 'fa-star',
                color: 'from-lime-400 to-emerald-600',
                border: 'border-lime-500/40',
                root: 7, // Gsus4
                type: 'sus4',
                desc: '解決を待ちわびる爽やかな緊張感'
            },
            {
                id: 'deep-night',
                name: '深夜の静けさ',
                tag: 'クール・大人',
                icon: 'fa-moon',
                color: 'from-slate-500 to-indigo-800',
                border: 'border-slate-500/40',
                root: 9, // Am7
                type: 'min7',
                desc: '落ち着いた夜の空気感'
            }
        ];

        // 音名リスト（シャープ表記）
        const NOTE_NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];

        // コード構成音（ルートからの半音インターバル）
        const CHORD_INTERVALS = {
            'maj':   [0, 4, 7],
            'min':   [0, 3, 7],
            '7':     [0, 4, 7, 10],
            'maj7':  [0, 4, 7, 11],
            'min7':  [0, 3, 7, 10],
            'sus4':  [0, 5, 7],
            'add9':  [0, 4, 7, 14],
            'dim':   [0, 3, 6],
            'aug':   [0, 4, 8],
            'm7b5':  [0, 3, 6, 10]
        };

        // コード表示用サフィックス
        const CHORD_SUFFIX = {
            'maj':   '',
            'min':   'm',
            '7':     '7',
            'maj7':  'M7',
            'min7':  'm7',
            'sus4':  'sus4',
            'add9':  'add9',
            'dim':   'dim',
            'aug':   'aug',
            'm7b5':  'm7-5'
        };

        // 全コード選択用のタイプ定義
        const ALL_CHORD_TYPES = [
            { type: 'maj',  label: 'メジャー (明るめ)', tag: '基本' },
            { type: 'min',  label: 'マイナー (切ない)', tag: '基本' },
            { type: '7',    label: 'セブンス (ブルージー)', tag: '展開' },
            { type: 'maj7', label: 'メジャー7th (おしゃれ)', tag: '洗練' },
            { type: 'min7', label: 'マイナー7th (都会的)', tag: '洗練' },
            { type: 'sus4', label: 'サスフォー (浮遊・期待)', tag: '変化' },
            { type: 'add9', label: 'アドナインス (爽やか)', tag: '透明感' },
            { type: 'dim',  label: 'ディミニッシュ (緊張)', tag: 'スパイス' },
            { type: 'aug',  label: 'オーギュメント (不思議)', tag: 'スパイス' },
            { type: 'm7b5', label: 'ハーフディミニッシュ', tag: 'ジャズ' }
        ];

        // ==========================================
        // 2. アプリケーション状態管理
        // ==========================================
        // 4小節分のスロット（初期状態は王道進行のブロック組み合わせ）
        let slots = [
            createSlotData('hopeful-lift'),   // 1小節目: 視界が開ける (F)
            createSlotData('emotional-peak'), // 2小節目: 感情の高まり (G)
            createSlotData('gentle-sorrow'),  // 3小節目: 夕暮れの優しさ (Em)
            createSlotData('sad-nostalgia')   // 4小節目: 切ない余韻 (Am)
        ];

        let paletteMode = 'mood'; // 'mood' | 'chords'
        let selectedRootNote = 0; // 全コード選択モードで選択中のルート音 (0=C)
        let selectedBassNote = -1; // 全コード選択モードで選択中のベース音 (-1=指定なし, 0..11=C..B)
        let draggedBlockId = null;
        let draggedCustomChord = null; // { root, type, bass }
        let draggedFromSlotIndex = null;
        let keyOffset = 0; // C=0
        let bpm = 115;
        let playStyle = 'rhythm';
        let isPlaying = false;
        let currentStep = 0;
        let synth = null;
        let loopEvent = null;

        function createSlotData(blockId) {
            const block = MOOD_BLOCKS.find(b => b.id === blockId);
            if (!block) return null;
            return {
                isCustom: false,
                blockId: block.id,
                name: block.name,
                tag: block.tag,
                icon: block.icon,
                color: block.color,
                root: block.root,
                type: block.type,
                bass: null // nullの場合はルート音と同じベース
            };
        }

        function createCustomChordSlotData(root, type, bass = null) {
            const typeInfo = ALL_CHORD_TYPES.find(t => t.type === type) || { label: type, tag: '直接指定' };
            return {
                isCustom: true,
                blockId: null,
                name: bass !== null ? 'オンコード指定' : 'コード直接指定',
                tag: bass !== null ? 'オンコード' : typeInfo.tag,
                icon: 'fa-music',
                color: bass !== null ? 'from-cyan-600 to-blue-700' : 'from-slate-600 to-slate-700',
                root: root,
                type: type,
                bass: bass
            };
        }

        // ==========================================
        // 3. 初期化処理
        // ==========================================
        window.addEventListener('DOMContentLoaded', () => {
            renderBlockPalette();
            renderAllChordsPalette();
            renderChordSlots();
            renderPianoKeyboard();
            updateMoodSummary();

            if (slots[0]) {
                const firstNotes = getChordMidiNotes(slots[0]);
                highlightKeys(firstNotes, getChordDisplayName(slots[0]));
            }
        });

        // Tone.js ピアノ風シンセサイザーの初期化
        async function initAudio() {
            if (!synth) {
                await Tone.start();
                synth = new Tone.PolySynth(Tone.Synth, {
                    oscillator: {
                        type: 'triangle'
                    },
                    envelope: {
                        attack: 0.02,
                        decay: 0.3,
                        sustain: 0.4,
                        release: 1.2
                    },
                    volume: -6
                }).toDestination();

                const reverb = new Tone.Reverb({
                    decay: 2.2,
                    wet: 0.25
                }).toDestination();
                synth.connect(reverb);
            }
        }

        // ==========================================
        // 4. UIレンダリング関数（パレット＆スロット）
        // ==========================================
        // パレットモードの切り替え（雰囲気ブロック vs 全コード直接選択）
        function switchPaletteMode(mode) {
            paletteMode = mode;
            const tabMood = document.getElementById('tab-mood');
            const tabChords = document.getElementById('tab-all-chords');
            const blockPalette = document.getElementById('block-palette');
            const chordsPalette = document.getElementById('all-chords-palette');

            if (mode === 'mood') {
                tabMood.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 bg-sky-600 text-white shadow-md shadow-sky-500/20';
                tabChords.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 bg-slate-800 text-slate-300 hover:bg-slate-700';
                blockPalette.classList.remove('hidden');
                chordsPalette.classList.add('hidden');
            } else {
                tabChords.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 bg-sky-600 text-white shadow-md shadow-sky-500/20';
                tabMood.className = 'px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 bg-slate-800 text-slate-300 hover:bg-slate-700';
                blockPalette.classList.add('hidden');
                chordsPalette.classList.remove('hidden');
                renderAllChordsPalette();
            }
        }

        // すべてのコード選択パレットの描画
        function renderAllChordsPalette() {
            const rootContainer = document.getElementById('root-note-selector');
            const typeGrid = document.getElementById('chord-type-grid');
            if (!rootContainer || !typeGrid) return;

            // 12音のルートボタン描画
            rootContainer.innerHTML = '';
            NOTE_NAMES.forEach((noteName, index) => {
                const isSharp = noteName.includes('#');
                const isSelected = selectedRootNote === index;
                const btn = document.createElement('button');
                btn.className = `py-2 px-1 rounded-lg text-xs sm:text-sm font-bold transition border ${
                    isSelected
                        ? 'bg-sky-500 border-sky-300 text-white shadow-md shadow-sky-500/30 scale-105'
                        : isSharp
                            ? 'bg-slate-900 border-slate-700 text-slate-300 hover:bg-slate-800'
                            : 'bg-slate-800 border-slate-600 text-white hover:bg-slate-700'
                }`;
                btn.textContent = noteName;
                btn.onclick = () => {
                    selectedRootNote = index;
                    renderAllChordsPalette();
                };
                rootContainer.appendChild(btn);
            });

            // 選択中のルート音に対する全コードタイプカードを描画
            typeGrid.innerHTML = '';
            const rootName = NOTE_NAMES[selectedRootNote];
            const bassSuffix = selectedBassNote !== -1 ? `/${NOTE_NAMES[selectedBassNote]}` : '';

            ALL_CHORD_TYPES.forEach(item => {
                const chordDisplay = rootName + CHORD_SUFFIX[item.type] + bassSuffix;
                const el = document.createElement('div');
                el.draggable = true;
                el.className = 'bg-slate-800/90 hover:bg-slate-700/90 border border-slate-700 hover:border-sky-500/60 rounded-xl p-2.5 cursor-grab active:cursor-grabbing transition transform hover:-translate-y-0.5 select-none flex flex-col justify-between gap-1 group';

                el.ondragstart = (e) => {
                    // 全コード選択で選んだコードは「現在のキーに対して絶対音程」になるよう補正して保持
                    const normalizedRoot = (selectedRootNote - keyOffset + 12) % 12;
                    const normalizedBass = selectedBassNote !== -1 ? (selectedBassNote - keyOffset + 12) % 12 : null;
                    draggedCustomChord = { root: normalizedRoot, type: item.type, bass: normalizedBass };
                    draggedBlockId = null;
                    draggedFromSlotIndex = null;
                    e.dataTransfer.effectAllowed = 'copy';
                    el.classList.add('opacity-50');
                };
                el.ondragend = () => {
                    el.classList.remove('opacity-50');
                    draggedCustomChord = null;
                };

                el.onclick = () => {
                    const normalizedRoot = (selectedRootNote - keyOffset + 12) % 12;
                    const normalizedBass = selectedBassNote !== -1 ? (selectedBassNote - keyOffset + 12) % 12 : null;
                    assignCustomChordToNextAvailableSlot(normalizedRoot, item.type, normalizedBass);
                };

                el.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-base sm:text-lg font-extrabold text-white group-hover:text-sky-300 transition">${chordDisplay}</span>
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-900 text-slate-400">${selectedBassNote !== -1 ? '分数' : item.tag}</span>
                    </div>
                    <div class="text-[11px] text-slate-400 truncate">${item.label}</div>
                `;
                typeGrid.appendChild(el);
            });
        }

        // パレットのベース音（オンコード）選択変更
        function changePaletteBassNote(val) {
            selectedBassNote = parseInt(val, 10);
            renderAllChordsPalette();
        }

        // 雰囲気ブロック・パレットの描画
        function renderBlockPalette() {
            const palette = document.getElementById('block-palette');
            palette.innerHTML = '';

            MOOD_BLOCKS.forEach(block => {
                const el = document.createElement('div');
                el.draggable = true;
                el.className = `bg-slate-800/80 hover:bg-slate-800 border ${block.border} rounded-xl p-2.5 cursor-grab active:cursor-grabbing transition transform hover:-translate-y-0.5 shadow-sm select-none flex flex-col justify-between gap-1.5 group`;

                // ドラッグ開始イベント
                el.ondragstart = (e) => {
                    draggedBlockId = block.id;
                    draggedCustomChord = null;
                    draggedFromSlotIndex = null;
                    e.dataTransfer.effectAllowed = 'copy';
                    el.classList.add('opacity-50');
                };
                el.ondragend = () => {
                    el.classList.remove('opacity-50');
                    draggedBlockId = null;
                };

                // タップ（クリック）で空きスロットまたは次のスロットへ自動配置
                el.onclick = () => {
                    assignBlockToNextAvailableSlot(block.id);
                };

                el.innerHTML = `
                    <div class="flex items-center justify-between gap-1.5">
                        <div class="w-7 h-7 rounded-lg bg-gradient-to-br ${block.color} flex items-center justify-center text-white text-xs shadow shrink-0">
                            <i class="fa-solid ${block.icon}"></i>
                        </div>
                        <span class="text-[10px] font-medium px-1.5 py-0.5 rounded bg-slate-900/90 text-slate-300 truncate">
                            ${block.tag}
                        </span>
                    </div>
                    <div>
                        <div class="font-bold text-xs sm:text-sm text-white group-hover:text-sky-300 transition">${block.name}</div>
                        <div class="text-[10px] text-slate-400 line-clamp-1">${block.desc}</div>
                    </div>
                `;
                palette.appendChild(el);
            });
        }

        // 空いているスロット（または順番に上書き）へ雰囲気ブロックを配置
        function assignBlockToNextAvailableSlot(blockId) {
            let targetIndex = slots.findIndex(s => s === null);
            if (targetIndex === -1) {
                targetIndex = window._nextOverwriteIndex || 0;
                window._nextOverwriteIndex = (targetIndex + 1) % 4;
            }
            setSlotBlock(targetIndex, blockId);
        }

        // 空いているスロット（または順番に上書き）へ直接選択コードを配置
        function assignCustomChordToNextAvailableSlot(root, type, bass = null) {
            let targetIndex = slots.findIndex(s => s === null);
            if (targetIndex === -1) {
                targetIndex = window._nextOverwriteIndex || 0;
                window._nextOverwriteIndex = (targetIndex + 1) % 4;
            }
            setSlotCustomChord(targetIndex, root, type, bass);
        }

        // 指定スロットに雰囲気ブロックをセット
        function setSlotBlock(slotIndex, blockId) {
            slots[slotIndex] = createSlotData(blockId);
            renderChordSlots();
            updateMoodSummary();
            previewSingleChord(slotIndex);
        }

        // 指定スロットに直接指定コードをセット
        function setSlotCustomChord(slotIndex, root, type, bass = null) {
            slots[slotIndex] = createCustomChordSlotData(root, type, bass);
            renderChordSlots();
            updateMoodSummary();
            previewSingleChord(slotIndex);
        }

        // スロットのブロックを解除
        function clearSlot(slotIndex, event) {
            if (event) event.stopPropagation();
            slots[slotIndex] = null;
            renderChordSlots();
            updateMoodSummary();
        }

        // 全スロットリセット
        function clearAllSlots() {
            if (isPlaying) stopPlayback();
            slots = [null, null, null, null];
            window._nextOverwriteIndex = 0;
            renderChordSlots();
            updateMoodSummary();
            highlightKeys([], 'ブロックを配置してください');
            showToast('スロットを空にしました');
        }

        // ランダムに4つのブロックを組み合わせて提案
        function generateRandomBlocks() {
            const starters = ['bright-start', 'hopeful-lift', 'lofi-chill', 'sad-nostalgia', 'floating-dream'];
            const middles = ['emotional-peak', 'gentle-sorrow', 'walking-memory', 'jazz-spice', 'dramatic-twist', 'anticipation'];
            const endings = ['sad-nostalgia', 'floating-dream', 'deep-night', 'hopeful-lift', 'bright-start'];

            const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];
            slots = [
                createSlotData(pick(starters)),
                createSlotData(pick(middles)),
                createSlotData(pick(middles)),
                createSlotData(pick(endings))
            ];

            renderChordSlots();
            updateMoodSummary();
            showToast('雰囲気ブロックをランダムに組み合わせました！');
            if (!isPlaying) {
                togglePlay();
            }
        }

        // 組み合わせから全体の雰囲気テキストを自動生成
        function updateMoodSummary() {
            const summaryEl = document.getElementById('progression-mood-summary');
            const activeSlots = slots.filter(s => s !== null);

            if (activeSlots.length === 0) {
                summaryEl.textContent = '上の雰囲気ブロックまたはコードを選んで、1〜4小節目のスロットを埋めてください';
                return;
            }

            const names = activeSlots.map(s => s.isCustom ? `[${getChordDisplayName(s)}]` : `「${s.name}」`).join(' → ');
            summaryEl.textContent = `現在の構成：${names}`;
        }

        // 4つのコードスロットの描画（ドロップ受け入れ対応）
        function renderChordSlots() {
            const container = document.getElementById('chord-slots');
            container.innerHTML = '';

            slots.forEach((slot, index) => {
                const card = document.createElement('div');
                card.id = `chord-card-${index}`;

                // ドラッグ＆ドロップ受け入れイベント
                card.ondragover = (e) => {
                    e.preventDefault();
                    card.classList.add('ring-2', 'ring-sky-400', 'bg-slate-800/90');
                };
                card.ondragleave = () => {
                    card.classList.remove('ring-2', 'ring-sky-400', 'bg-slate-800/90');
                };
                card.ondrop = (e) => {
                    e.preventDefault();
                    card.classList.remove('ring-2', 'ring-sky-400', 'bg-slate-800/90');

                    if (draggedBlockId) {
                        setSlotBlock(index, draggedBlockId);
                    } else if (draggedCustomChord) {
                        setSlotCustomChord(index, draggedCustomChord.root, draggedCustomChord.type, draggedCustomChord.bass);
                    } else if (draggedFromSlotIndex !== null && draggedFromSlotIndex !== index) {
                        // スロット間の入れ替え
                        const temp = slots[index];
                        slots[index] = slots[draggedFromSlotIndex];
                        slots[draggedFromSlotIndex] = temp;
                        renderChordSlots();
                        updateMoodSummary();
                        if (slots[index]) previewSingleChord(index);
                    }
                };

                // 空スロットの場合の表示
                if (!slot) {
                    card.className = 'bg-slate-900/40 border-2 border-dashed border-slate-700 rounded-2xl p-4 min-h-[210px] flex flex-col items-center justify-center text-center transition-all hover:border-sky-500/50';
                    card.innerHTML = `
                        <span class="text-xs font-mono text-slate-500 mb-2">${index + 1}小節目</span>
                        <div class="w-10 h-10 rounded-full bg-slate-800/80 flex items-center justify-center text-slate-500 mb-2">
                            <i class="fa-solid fa-plus"></i>
                        </div>
                        <p class="text-xs text-slate-400">ここにドロップ<br>または上のピースをタップ</p>
                    `;
                    container.appendChild(card);
                    return;
                }

                // ブロックまたはコードが配置されている場合の表示
                const chordName = getChordDisplayName(slot);
                const actualRoot = (slot.root + keyOffset + 12) % 12;
                const actualBass = (slot.bass !== null && slot.bass !== undefined) ? (slot.bass + keyOffset + 12) % 12 : -1;

                card.draggable = true;
                card.className = 'bg-slate-900/95 border-2 border-slate-700/90 rounded-2xl p-4 min-h-[210px] flex flex-col justify-between transition-all duration-150 hover:border-sky-500/60 cursor-pointer relative group';

                // スロット自体のドラッグ（並び替え用）
                card.ondragstart = (e) => {
                    draggedFromSlotIndex = index;
                    draggedBlockId = null;
                    draggedCustomChord = null;
                    e.dataTransfer.effectAllowed = 'move';
                    card.classList.add('opacity-50');
                };
                card.ondragend = () => {
                    card.classList.remove('opacity-50');
                    draggedFromSlotIndex = null;
                };

                // カードクリックで単音試聴
                card.onclick = (e) => {
                    if (e.target.closest('button') || e.target.closest('select')) return;
                    previewSingleChord(index);
                };

                // ルート音選択肢オプション
                const rootOptions = NOTE_NAMES.map((n, rIdx) =>
                    `<option value="${rIdx}" ${rIdx === actualRoot ? 'selected' : ''}>${n}</option>`
                ).join('');

                // タイプ選択肢オプション
                const typeOptions = ALL_CHORD_TYPES.map(t =>
                    `<option value="${t.type}" ${t.type === slot.type ? 'selected' : ''}>${CHORD_SUFFIX[t.type] || 'Major'}</option>`
                ).join('');

                // オンコード（ベース音）選択肢オプション
                const bassOptions = `<option value="-1" ${actualBass === -1 ? 'selected' : ''}>/ベースなし</option>` +
                    NOTE_NAMES.map((n, bIdx) =>
                        `<option value="${bIdx}" ${bIdx === actualBass ? 'selected' : ''}>/${n}</option>`
                    ).join('');

                card.innerHTML = `
                    <!-- ヘッダー：小節番号と解除ボタン -->
                    <div class="flex items-center justify-between gap-1">
                        <span class="text-[11px] font-mono bg-slate-800 px-2 py-0.5 rounded text-slate-300">${index + 1}小節目</span>
                        <button onclick="clearSlot(${index}, event)" class="w-6 h-6 rounded-full bg-slate-800 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 flex items-center justify-center text-xs transition" title="このスロットを空にする">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <!-- 配置されたピースラベル -->
                    <div class="mt-2 flex items-center gap-2 bg-slate-800/90 border border-slate-700/80 px-2.5 py-1.5 rounded-xl">
                        <div class="w-6 h-6 rounded-md bg-gradient-to-br ${slot.color} flex items-center justify-center text-white text-xs shrink-0">
                            <i class="fa-solid ${slot.icon}"></i>
                        </div>
                        <div class="truncate">
                            <div class="text-xs font-bold text-slate-100 truncate">${slot.isCustom ? (slot.bass !== null ? 'オンコード指定' : 'コード直接指定') : slot.name}</div>
                        </div>
                    </div>

                    <!-- コード名表示 ＆ 直接変更セレクタ -->
                    <div class="my-2 text-center">
                        <div class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">${chordName}</div>
                        <div class="text-[11px] text-slate-400 font-mono mb-1.5">${getChordNoteNamesText(slot)}</div>
                        <!-- スロット内で直接コードを書き換えられるミニプルダウン -->
                        <div class="flex flex-wrap items-center justify-center gap-1" onclick="event.stopPropagation()">
                            <select onchange="directChangeSlotChord(${index}, this.value, null, undefined)" class="bg-slate-800 border border-slate-700 text-[11px] text-slate-200 rounded px-1.5 py-0.5 focus:outline-none focus:border-sky-500" title="ルート音を直接変更">
                                ${rootOptions}
                            </select>
                            <select onchange="directChangeSlotChord(${index}, null, this.value, undefined)" class="bg-slate-800 border border-slate-700 text-[11px] text-slate-200 rounded px-1.5 py-0.5 focus:outline-none focus:border-sky-500" title="コードの種類を直接変更">
                                ${typeOptions}
                            </select>
                            <select onchange="directChangeSlotChord(${index}, null, null, this.value)" class="bg-slate-800 border ${actualBass !== -1 ? 'border-sky-500 text-sky-300 font-bold' : 'border-slate-700 text-slate-300'} text-[11px] rounded px-1.5 py-0.5 focus:outline-none focus:border-sky-500" title="オンコード（ベース音）を指定">
                                ${bassOptions}
                            </select>
                        </div>
                    </div>

                    <!-- ワンタッチ微調整ボタン -->
                    <div class="pt-2 border-t border-slate-800 flex items-center justify-between gap-1.5">
                        <button onclick="toggleSeventh(${index})" class="flex-1 text-[11px] py-1.5 px-2 rounded-lg border transition ${
                            slot.type.includes('7') 
                            ? 'bg-amber-500/20 border-amber-500/50 text-amber-300 font-bold' 
                            : 'bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700'
                        }" title="7thの音を加えておしゃれな響きにします">
                            ✨ おしゃれ化
                        </button>
                        <button onclick="cycleChordVariation(${index})" class="flex-1 text-[11px] py-1.5 px-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 transition" title="別のバリエーションに変更">
                            🔄 響き変更
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // スロット内のプルダウンから直接コードを変更
        function directChangeSlotChord(index, newActualRootStr, newType, newActualBassStr) {
            const slot = slots[index];
            if (!slot) return;

            if (newActualRootStr !== null) {
                const newActualRoot = parseInt(newActualRootStr, 10);
                slot.root = (newActualRoot - keyOffset + 12) % 12;
            }
            if (newType !== null) {
                slot.type = newType;
            }
            if (newActualBassStr !== undefined) {
                const bassVal = parseInt(newActualBassStr, 10);
                if (bassVal === -1) {
                    slot.bass = null;
                } else {
                    slot.bass = (bassVal - keyOffset + 12) % 12;
                }
            }

            slot.isCustom = true;
            slot.name = slot.bass !== null ? 'オンコード指定' : 'コード直接指定';
            slot.icon = 'fa-music';
            slot.color = slot.bass !== null ? 'from-cyan-600 to-blue-700' : 'from-slate-600 to-slate-700';

            renderChordSlots();
            updateMoodSummary();
            previewSingleChord(index);
        }

        // ==========================================
        // 5. コード計算＆アレンジロジック
        // ==========================================
        function getChordDisplayName(chord) {
            const actualRoot = (chord.root + keyOffset + 12) % 12;
            let name = NOTE_NAMES[actualRoot] + CHORD_SUFFIX[chord.type];
            if (chord.bass !== null && chord.bass !== undefined) {
                const actualBass = (chord.bass + keyOffset + 12) % 12;
                name += '/' + NOTE_NAMES[actualBass];
            }
            return name;
        }

        function getChordMidiNotes(chord) {
            const actualRoot = (chord.root + keyOffset + 12) % 12;
            const baseMidi = 60 + actualRoot;
            const intervals = CHORD_INTERVALS[chord.type];

            // オンコード指定があればその音を低音部(C3=48〜B3=59)に配置、なければルートの1オクターブ下
            let bassNote;
            if (chord.bass !== null && chord.bass !== undefined) {
                const actualBass = (chord.bass + keyOffset + 12) % 12;
                bassNote = 48 + actualBass;
            } else {
                bassNote = baseMidi - 12;
            }

            const chordNotes = intervals.map(interval => baseMidi + interval);
            return [bassNote, ...chordNotes];
        }

        function getChordNoteNamesText(chord) {
            const actualRoot = (chord.root + keyOffset + 12) % 12;
            const intervals = CHORD_INTERVALS[chord.type];
            const chordNotesText = intervals.map(i => NOTE_NAMES[(actualRoot + i) % 12]).join(' - ');
            if (chord.bass !== null && chord.bass !== undefined) {
                const actualBass = (chord.bass + keyOffset + 12) % 12;
                return `Bass:${NOTE_NAMES[actualBass]} | ${chordNotesText}`;
            }
            return chordNotesText;
        }

        // おしゃれ化（7thのON/OFF切り替え）
        function toggleSeventh(index) {
            const chord = slots[index];
            if (!chord) return;
            if (chord.type === 'maj') chord.type = 'maj7';
            else if (chord.type === 'maj7') chord.type = 'maj';
            else if (chord.type === 'min') chord.type = 'min7';
            else if (chord.type === 'min7') chord.type = 'min';
            else if (chord.type === '7') chord.type = 'maj';
            else chord.type = 'maj7';

            renderChordSlots();
            previewSingleChord(index);
        }

        // 響き変更（同系統のバリエーション切り替え）
        function cycleChordVariation(index) {
            const chord = slots[index];
            if (!chord) return;
            const isMinorBase = chord.type.startsWith('min');
            const variations = isMinorBase ? ['min', 'min7'] : ['maj', 'maj7', 'add9', 'sus4', '7'];
            const nextIdx = (variations.indexOf(chord.type) + 1) % variations.length;
            chord.type = variations[nextIdx];

            renderChordSlots();
            previewSingleChord(index);
        }

        // ==========================================
        // 6. ピアノ鍵盤ビジュアライザー
        // ==========================================
        // C3 (48) から B4 (71) までの2オクターブを描画
        function renderPianoKeyboard() {
            const container = document.getElementById('piano-keyboard');
            container.innerHTML = '';

            const startMidi = 48; // C3
            const endMidi = 71;   // B4
            const whiteKeys = [];

            // まず白鍵を並べる
            for (let midi = startMidi; midi <= endMidi; midi++) {
                const noteInOctave = midi % 12;
                const isBlack = [1, 3, 6, 8, 10].includes(noteInOctave);
                if (!isBlack) {
                    const keyEl = document.createElement('div');
                    keyEl.dataset.midi = midi;
                    keyEl.className = 'white-key flex-1 h-full flex items-end justify-center pb-2 text-[10px] font-bold text-slate-400 cursor-pointer';
                    keyEl.textContent = NOTE_NAMES[noteInOctave] + (Math.floor(midi / 12) - 1);
                    keyEl.onclick = () => playSingleNote(midi);
                    container.appendChild(keyEl);
                    whiteKeys.push({ midi, el: keyEl });
                }
            }

            // 黒鍵を白鍵の間に絶対配置
            const totalWhite = whiteKeys.length;
            whiteKeys.forEach((wk, idx) => {
                const noteInOctave = wk.midi % 12;
                // E(4)とB(11)の右側には黒鍵がない
                if (noteInOctave !== 4 && noteInOctave !== 11 && idx < totalWhite - 1) {
                    const blackMidi = wk.midi + 1;
                    const blackEl = document.createElement('div');
                    blackEl.dataset.midi = blackMidi;
                    const leftPercent = ((idx + 1) / totalWhite) * 100;
                    const widthPercent = (1 / totalWhite) * 62;

                    blackEl.style.left = `calc(${leftPercent}% - ${widthPercent / 2}%)`;
                    blackEl.style.width = `${widthPercent}%`;
                    blackEl.className = 'black-key absolute top-0 h-[62%] cursor-pointer';
                    blackEl.onclick = (e) => {
                        e.stopPropagation();
                        playSingleNote(blackMidi);
                    };
                    container.appendChild(blackEl);
                }
            });
        }

        // 指定したMIDIノート番号の鍵盤を光らせる
        function highlightKeys(midiNotes, chordLabel = '') {
            document.querySelectorAll('.white-key, .black-key').forEach(el => {
                const m = parseInt(el.dataset.midi, 10);
                if (midiNotes.includes(m)) {
                    el.classList.add('active');
                } else {
                    el.classList.remove('active');
                }
            });

            if (chordLabel) {
                const noteNames = midiNotes.map(m => NOTE_NAMES[m % 12]).join(', ');
                document.getElementById('active-notes-text').textContent = `${chordLabel} (${noteNames})`;
            }
        }

        // 鍵盤クリック時の単音再生
        async function playSingleNote(midi) {
            await initAudio();
            const freq = Tone.Frequency(midi, 'midi').toNote();
            synth.triggerAttackRelease(freq, '8n');
            highlightKeys([midi], NOTE_NAMES[midi % 12]);
        }

        // ==========================================
        // 7. オーディオ再生・シーケンサーエンジン
        // ==========================================
        // コード1つを試聴
        async function previewSingleChord(index) {
            const chord = slots[index];
            if (!chord) return;
            await initAudio();
            const midiNotes = getChordMidiNotes(chord);
            const noteNames = midiNotes.map(m => Tone.Frequency(m, 'midi').toNote());

            synth.triggerAttackRelease(noteNames, '2n');
            highlightKeys(midiNotes, `${chord.name} (${getChordDisplayName(chord)})`);

            document.querySelectorAll('[id^="chord-card-"]').forEach((c, i) => {
                if (i === index) {
                    c.classList.add('border-sky-400', 'bg-slate-800', 'scale-[1.02]');
                } else {
                    c.classList.remove('border-sky-400', 'bg-slate-800', 'scale-[1.02]');
                }
            });
        }

        // ループ再生の開始・停止
        async function togglePlay() {
            if (slots.every(s => s === null)) {
                showToast('まずは雰囲気ブロックを1つ以上配置してください！');
                return;
            }
            await initAudio();

            if (isPlaying) {
                stopPlayback();
            } else {
                startPlayback();
            }
        }

        function startPlayback() {
            isPlaying = true;
            currentStep = 0;

            const playBtn = document.getElementById('play-btn');
            const playIcon = document.getElementById('play-icon');
            const playText = document.getElementById('play-text');

            playBtn.classList.remove('from-sky-500', 'to-blue-600');
            playBtn.classList.add('from-rose-500', 'to-red-600');
            playIcon.className = 'fa-solid fa-stop';
            playText.textContent = '停止する';

            Tone.Transport.bpm.value = bpm;

            // 1小節ごとのループイベント
            loopEvent = new Tone.Loop((time) => {
                const stepIndex = currentStep % 4;
                const chord = slots[stepIndex];

                if (chord) {
                    const midiNotes = getChordMidiNotes(chord);
                    const freqs = midiNotes.map(m => Tone.Frequency(m, 'midi').toNote());

                    const quarterNote = Tone.Time('4n').toSeconds();
                    if (playStyle === 'block') {
                        synth.triggerAttackRelease(freqs, '1m', time);
                    } else if (playStyle === 'arpeggio') {
                        freqs.forEach((f, idx) => {
                            synth.triggerAttackRelease(f, '2n', time + idx * (quarterNote * 0.5));
                        });
                    } else if (playStyle === 'rhythm') {
                        for (let beat = 0; beat < 4; beat++) {
                            synth.triggerAttackRelease(freqs, '8n', time + beat * quarterNote);
                        }
                    }

                    Tone.Draw.schedule(() => {
                        highlightKeys(midiNotes, `${chord.name} (${getChordDisplayName(chord)})`);
                        document.querySelectorAll('[id^="chord-card-"]').forEach((c, i) => {
                            if (i === stepIndex) {
                                c.classList.add('border-sky-400', 'bg-slate-800', 'scale-[1.03]', 'shadow-lg', 'shadow-sky-500/20');
                            } else {
                                c.classList.remove('border-sky-400', 'bg-slate-800', 'scale-[1.03]', 'shadow-lg', 'shadow-sky-500/20');
                            }
                        });
                    }, time);
                } else {
                    // 空スロット（休符）の場合のUIハイライト
                    Tone.Draw.schedule(() => {
                        highlightKeys([], `${stepIndex + 1}小節目（休符）`);
                        document.querySelectorAll('[id^="chord-card-"]').forEach((c, i) => {
                            if (i === stepIndex) {
                                c.classList.add('border-sky-400', 'scale-[1.02]');
                            } else {
                                c.classList.remove('border-sky-400', 'scale-[1.02]');
                            }
                        });
                    }, time);
                }

                currentStep++;
            }, '1m').start(0);

            Tone.Transport.start();
        }

        function stopPlayback() {
            isPlaying = false;
            Tone.Transport.stop();
            if (loopEvent) {
                loopEvent.dispose();
                loopEvent = null;
            }
            if (synth) {
                synth.releaseAll();
            }

            const playBtn = document.getElementById('play-btn');
            const playIcon = document.getElementById('play-icon');
            const playText = document.getElementById('play-text');

            playBtn.classList.remove('from-rose-500', 'to-red-600');
            playBtn.classList.add('from-sky-500', 'to-blue-600');
            playIcon.className = 'fa-solid fa-play';
            playText.textContent = '再生する';

            document.querySelectorAll('[id^="chord-card-"]').forEach(c => {
                c.classList.remove('border-sky-400', 'bg-slate-800', 'scale-[1.03]', 'shadow-lg', 'shadow-sky-500/20');
            });
        }

        // パラメータ変更ハンドラ
        function changeKey(val) {
            keyOffset = parseInt(val, 10);
            renderChordSlots();
            updateMoodSummary();
            const firstActive = slots.find(s => s !== null);
            if (firstActive) {
                const firstNotes = getChordMidiNotes(firstActive);
                const label = firstActive.isCustom ? getChordDisplayName(firstActive) : `${firstActive.name} (${getChordDisplayName(firstActive)})`;
                highlightKeys(firstNotes, label);
            }
        }

        function changeBpm(val) {
            bpm = parseInt(val, 10);
            document.getElementById('bpm-display').textContent = bpm;
            if (isPlaying) {
                Tone.Transport.bpm.value = bpm;
            }
        }

        function changePlayStyle(val) {
            playStyle = val;
        }

        // ==========================================
        // 8. 書き出し機能（テキストコピー & SMF MIDI生成）
        // ==========================================
        function copyProgressionText() {
            const activeSlots = slots.filter(s => s !== null);
            if (activeSlots.length === 0) {
                showToast('コピーするブロックがありません');
                return;
            }
            const chordNames = slots.map(s => s ? `${getChordDisplayName(s)}[${s.name}]` : '(休符)').join(' → ');
            const keyName = document.getElementById('key-select').selectedOptions[0].text.split('（')[0];
            const copyText = `【ChordCraft 雰囲気ブロックコード進行】\nキー: ${keyName} / BPM: ${bpm}\n構成: ${chordNames}`;

            const textArea = document.createElement('textarea');
            textArea.value = copyText;
            document.body.appendChild(textArea);
            textArea.select();
            try {
                document.execCommand('copy');
                showToast('コード進行をクリップボードにコピーしました！');
            } catch (err) {
                showToast('コピーに失敗しました');
            }
            document.body.removeChild(textArea);
        }

        // 外部ライブラリなしで標準MIDIファイル(.mid)をバイナリ生成してダウンロード
        function downloadMidi() {
            if (slots.every(s => s === null)) {
                showToast('保存するブロックがありません');
                return;
            }
            const ticksPerBeat = 480;
            const barTicks = ticksPerBeat * 4;
            const microsecondsPerBeat = Math.round(60000000 / bpm);

            function writeVarLen(value) {
                let buffer = [value & 0x7F];
                while ((value >>= 7) > 0) {
                    buffer.unshift((value & 0x7F) | 0x80);
                }
                return buffer;
            }

            let trackEvents = [];

            trackEvents.push(0x00, 0xFF, 0x51, 0x03,
                (microsecondsPerBeat >> 16) & 0xFF,
                (microsecondsPerBeat >> 8) & 0xFF,
                microsecondsPerBeat & 0xFF
            );

            // 4小節分のNote On / Note Offイベントを追加（空スロットは休符として時間を進める）
            let pendingDelta = 0;
            slots.forEach((chord) => {
                if (!chord) {
                    pendingDelta += barTicks;
                    return;
                }
                const notes = getChordMidiNotes(chord);

                notes.forEach((midiNote, idx) => {
                    const delta = idx === 0 ? writeVarLen(pendingDelta) : [0x00];
                    trackEvents.push(...delta, 0x90, midiNote, 0x5A);
                });
                pendingDelta = 0;

                notes.forEach((midiNote, idx) => {
                    const delta = idx === 0 ? writeVarLen(barTicks) : [0x00];
                    trackEvents.push(...delta, 0x80, midiNote, 0x00);
                });
            });

            trackEvents.push(...writeVarLen(pendingDelta), 0xFF, 0x2F, 0x00);

            const headerChunk = [
                0x4D, 0x54, 0x68, 0x64,
                0x00, 0x00, 0x00, 0x06,
                0x00, 0x00,
                0x00, 0x01,
                (ticksPerBeat >> 8) & 0xFF, ticksPerBeat & 0xFF
            ];

            const trackLength = trackEvents.length;
            const trackHeader = [
                0x4D, 0x54, 0x72, 0x6B,
                (trackLength >> 24) & 0xFF,
                (trackLength >> 16) & 0xFF,
                (trackLength >> 8) & 0xFF,
                trackLength & 0xFF
            ];

            const midiBytes = new Uint8Array([...headerChunk, ...trackHeader, ...trackEvents]);
            const blob = new Blob([midiBytes], { type: 'audio/midi' });
            const url = URL.createObjectURL(blob);

            const a = document.createElement('a');
            a.href = url;
            a.download = `ChordCraft_Blocks.mid`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            showToast('MIDIファイル(.mid)を保存しました！DTMソフトで開けます');
        }

        // ==========================================
        // 9. トースト＆モーダル制御
        // ==========================================
        let toastTimer = null;
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');

            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function openHelpModal() {
            const modal = document.getElementById('help-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeHelpModal() {
            const modal = document.getElementById('help-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>
</body>
